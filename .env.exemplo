# =====================================================================
# Sistema CSSO - configuracao. Copie para .env e ajuste.
# NUNCA versione o .env. NUNCA coloque caminho de usuario no codigo.
# =====================================================================

# --- Rede -------------------------------------------------------------
# 127.0.0.1 = so o proprio notebook. 0.0.0.0 = aceita conexao de QUALQUER
# endereco que consiga rotear ate esta maquina - quem estreita isso e a regra
# de firewall, e ela deve limitar a ORIGEM. Passo a passo em
# entrada/implantacao/01_REDE_DO_SETOR.md; leia docs/POLITICA_RETENCAO.md antes.
CSSO_HOST=127.0.0.1
CSSO_PORTA=8765
CSSO_ABRIR_NAVEGADOR=true

# --- Banco ------------------------------------------------------------
# Caminho relativo a raiz do projeto. NUNCA aponte para OneDrive/Dropbox.
CSSO_BANCO_URL=sqlite+pysqlite:///dados/csso.db

# --- Seguranca --------------------------------------------------------
# Gere um valor novo: python -c "import secrets;print(secrets.token_hex(32))"
CSSO_CHAVE_SECRETA=troque-esta-chave-antes-de-usar-em-producao
CSSO_SESSAO_HORAS=12
CSSO_MAX_TENTATIVAS=5
CSSO_BLOQUEIO_MINUTOS=15

# O atributo Secure do cookie de sessao. Quem decide e a CONEXAO, nunca o
# CSSO_HOST - o endereco de ligacao nao sabe se ha TLS.
#   auto  (padrao) o sistema olha o esquema da requisicao, ja corrigido pelo
#         X-Forwarded-Proto quando ha proxy confiavel a frente. Serve para
#         quase tudo, inclusive para proxy com TLS na mesma maquina.
#   sim   ha TLS num proxy que o uvicorn nao reconhece, e voce esta declarando
#         isso. CUIDADO: "sim" SEM TLS de verdade faz o login voltar para a
#         tela de login, sem mensagem, para todo mundo.
#   nao   desliga o Secure mesmo havendo https. So para diagnostico.
CSSO_COOKIE_SEGURO=auto

# --- Arquivos ---------------------------------------------------------
CSSO_DIR_DOCUMENTOS=dados/documentos
CSSO_DIR_ANEXOS=dados/anexos
CSSO_DIR_ENTRADA=entrada
CSSO_PERFIL_LO=dados/perfil_lo

# --- Registro de acesso HTTP ------------------------------------------
# Quem bateu na porta, de onde, quando e com que resposta. NAO grava nome,
# SIAPE, conteudo de parecer, query string nem o id do processo/servidor
# consultado (a rota sai como /servidores/{servidor_id}) - a regra e a secao 6
# do docs/ROPA.md. O arquivo tem endereco de origem, entao E dado pessoal:
# 90 dias, o mesmo prazo da tabela `sessao`, com rotacao diaria que apaga
# sozinha o que passou do prazo.
CSSO_DIR_LOGS=dados/logs
CSSO_LOG_ACESSO=true
CSSO_LOG_RETENCAO_DIAS=90

# --- Backup -----------------------------------------------------------
# Disco local ou rede institucional. Nuvem pessoal e PROIBIDO (LGPD 33-36).
CSSO_BACKUP_DESTINO=dados/backups
CSSO_BACKUP_SENHA=troque-esta-senha-de-backup

# --- PDF (opcional, degradavel) ---------------------------------------
# Deixe vazio para autodeteccao nos caminhos padrao do LibreOffice.
CSSO_SOFFICE=

# --- Gestao de EPI: onde retirar --------------------------------------
# Predio, sala e horario do balcao que entrega o EPI. Sai na ficha do pedido
# quando o item esta RESERVADO - e o unico momento em que ha equipamento
# separado com o nome de quem pediu, e ate agora a tela nao dizia a que porta
# ir. Deixe VAZIO se ainda nao souber: a tela diz que o local nao esta
# registrado, que e melhor do que mandar a pessoa ao lugar errado.
CSSO_EPI_LOCAL_RETIRADA=

# --- Migracao do Trello (so durante a carga; apague depois) -----------
# O quadro e privado: baixar exige credencial propria.
#   1. https://trello.com/power-ups/admin -> criar Power-Up -> API key
#   2. na mesma tela, gerar o Token a partir da chave
# Escreva os dois AQUI, nunca em linha de comando e nunca no repositorio.
CSSO_TRELLO_KEY=
CSSO_TRELLO_TOKEN=

# --- Ambiente ---------------------------------------------------------
CSSO_AMBIENTE=local
CSSO_FUSO_EXIBICAO=America/Sao_Paulo
