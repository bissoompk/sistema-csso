# Copie para .env (local) ou cadastre no Netlify (Site configuration > Environment variables).
# Supabase > Project Settings > Database > Connection string > Transaction pooler (porta 6543)
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
# gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CSSO_CHAVE_SECRETA=
# Supabase > Project Settings > API
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
CSSO_BUCKET=csso
# homologacao (instalação de teste: faixa amarela "só dados de teste" em toda tela)
# ou producao (recusa configuração insegura, bloqueia certificado sem URL pública,
# e as ferramentas que apagam o banco — ambiente-teste — deixam de rodar). Ver PRODUCAO.md.
CSSO_AMBIENTE=homologacao
# Em produção (CSSO_AMBIENTE=producao) o sistema RECUSA subir sem estas duas
# fortes: chave com 32+ caracteres (a linha de `gere com` acima) e senha dos
# backups cifrados com 16+ caracteres. Recusa também sem DATABASE_URL e com
# CSSO_COOKIE_SEGURO=nao. Lista completa e passo a passo: PRODUCAO.md.
CSSO_BACKUP_SENHA=
# Teto de falhas de login por endereço (em qualquer conta) na janela; 0 desliga.
# CSSO_MAX_FALHAS_IP=30
# CSSO_JANELA_IP_MINUTOS=15
# Raiz do endereço público de validação do certificado (vai CONGELADA no QR).
# O que vale é o parâmetro `certificado.url_publica` do banco, gravado pelo
# `producao-iniciar`; esta variável é o recuo. Em produção, sem um dos dois, a
# emissão fica bloqueada.
# CSSO_URL_PUBLICA=https://<endereço definitivo>
# Conversor de PDF do modelo enviado (Gotenberg; PRODUCAO.md §2.1). Sem a URL,
# o certificado de modelo enviado sai só em Word.
# CSSO_CONVERSOR_PDF_URL=https://csso-conversor-pdf-<id>.southamerica-east1.run.app
# CSSO_CONVERSOR_PDF_USUARIO=csso
# CSSO_CONVERSOR_PDF_SENHA=
# Segredo que a rotina agendada (rotina-noturna) apresenta à função de fundo do
# backup (backup-background, que tem URL pública). 32+ caracteres; sem ele o
# backup diário NÃO roda. Gere como a CSSO_CHAVE_SECRETA (valor diferente).
CSSO_ROTINA_SEGREDO=
# E-mail do pedido de EPI (paridade com o IntegraSST). DESLIGADO por padrão.
# Com `sim`, o pedido enviado avisa o setor (endereço abaixo) e o requerente, e a
# decisão avisa o requerente — tudo pela caixa de saída, que só envia quando
# CSSO_SMTP_URL e CSSO_EMAIL_REMETENTE estiverem configurados (PRODUCAO.md §2.2).
# CSSO_EPI_EMAIL=sim
# CSSO_EPI_EMAIL_SETOR=sesmt@exemplo.ufvjm.edu.br
