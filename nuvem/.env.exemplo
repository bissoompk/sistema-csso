# Copie para .env (local) ou cadastre no Netlify (Site configuration > Environment variables).
# Supabase > Project Settings > Database > Connection string > Transaction pooler (porta 6543)
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
# gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CSSO_CHAVE_SECRETA=
# Supabase > Project Settings > API
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
CSSO_BUCKET=csso
CSSO_AMBIENTE=homologacao
